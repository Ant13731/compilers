{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Simile Rewrite Rules",
    "scopeName": "source.simrw",
    "fileTypes": [
        "simrw"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#rule"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "match": "#.*$",
                    "name": "comment.line.number-sign.simrw"
                }
            ]
        },
        "rule": {
            "begin": "^\\s*rule\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*:",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.function.simrw"
                },
                "0": {
                    "name": "keyword.control.rule.simrw"
                }
            },
            "end": "^(?=rule\\s)",
            "patterns": [
                {
                    "include": "#vars"
                },
                {
                    "include": "#rewrite"
                },
                {
                    "include": "#when"
                }
            ]
        },
        "vars": {
            "begin": "^\\s*vars:",
            "beginCaptures": {
                "0": {
                    "name": "keyword.control.simrw"
                }
            },
            "end": "^(?=\\s*(rewrite|when):)",
            "patterns": [
                {
                    "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "variable.parameter.simrw"
                        }
                    }
                },
                {
                    "include": "source.sim"
                }
            ]
        },
        "rewrite": {
            "begin": "^\\s*rewrite:",
            "end": "^(?=\\s*when:)",
            "beginCaptures": {
                "0": {
                    "name": "keyword.control.simrw"
                }
            },
            "patterns": [
                {
                    "include": "source.sim"
                },
                {
                    "match": "~>",
                    "name": "keyword.operator.rewrite.simrw"
                }
            ]
        },
        "when": {
            "begin": "^\\s*when:",
            "end": "^(?=rule\\s)",
            "beginCaptures": {
                "0": {
                    "name": "keyword.control.simrw"
                }
            },
            "patterns": [
                {
                    "include": "source.sim"
                }
            ]
        }
    }
}