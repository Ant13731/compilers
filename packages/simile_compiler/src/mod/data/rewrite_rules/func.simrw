rule count:
    vars:
        f: relation[T1, T2]
        x: T1
        E: T2
    rewrite:
        f(x) := E ~> f := f <+> {x |-> E}

rule count:
    vars:
        R: relation[T1, T2]
        Q: relation[T1, T2]
    rewrite:
        R <+> Q ~> Q \/ (dom(Q) <<| R)

rule cast:
    vars:
        X: T1
        T: type[T2]
    rewrite:
        cast(X, T) ~> X

rule cast_with:
    vars:
        X: T1
        T: type[T2]
        Ts: set[trait]
    rewrite:
        cast_with(X, T, Ts)
        ~>
        ast_.TraitApplication(X, Ts)

rule functional_image:
    vars:
        # Note: may fail if R is not total
        R: relation[T1, T2]
        x: T1
    rewrite:
        R(x) ~> choice(R[x])


