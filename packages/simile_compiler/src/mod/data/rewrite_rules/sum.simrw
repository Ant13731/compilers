rule constant_sum_upto:
    vars:
        c: T1
        S: set[T2]
        j: int
        k: int
    rewrite:
        sum i in j..k | c
        ~>
        (k-j) * c
    when:
        does_not_occur_in(x,c)
        is_numeric(T1)

rule constant_sum:
    vars:
        c: T1
        S: set[T2]
    rewrite:
        sum x in S | c
        ~>
        card(S) * c
    when:
        does_not_occur_in(x,c)
        is_numeric(T1)

rule sum_upto_i:
    vars:
        j: int
        k: int
    rewrite:
        sum i in j..k | i
        ~>
        -(j-k-1)*(j+k) / 2

rule sum_upto_i_squared:
    vars:
        j: int
        k: int
    rewrite:
        sum i in j..k | i ^ 2
        ~>
        -(j-k-1)*(2*j^2+2*j*k-j+2*k^2+k) / 6

rule sum_with_mult:
    vars:
        S: set[T1]
        m: T3
        E: T2
    rewrite:
        sum x in S | E * m
        ~>
        (sum x in S | E) * m
    when:
        is_numeric(T3)
