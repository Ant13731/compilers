rule concatenation:
    vars:
        L: seq[T1]
        M: seq[T1]
    rewrite:
        L ++ M
        ~>
        L \/ {x |-> y in M | x + max(dom(L)) |-> y}

rule flatten:
    vars:
        XS: seq[seq[T1]]
    rewrite:
        flatten(XS) ~> fold([], ++, XS)

rule first:
    vars:
        X: seq[T1]
    rewrite:
        first(X) ~> X(0)

rule tail:
    vars:
        X: seq[T1]
    rewrite:
        tail(X) ~> {i |-> x in X . i != 0 | i - 1 |-> x}

rule append:
    vars:
        X: seq[T1]
        y: T1
    rewrite:
        append(X, y) ~> X \/ {max(dom(X)) |-> y}

rule prepend:
    vars:
        X: seq[T1]
        y: T1
    rewrite:
        prepend(X, y) ~> {i |-> x in X | i+1 |-> x} \/ {0 |-> y}

rule tails:
    vars:
        X: seq[T1]
    rewrite:
        tails(X) ~> {i in len(X)..0 | X[i:]}

rule heads:
    vars:
        X: seq[T1]
    rewrite:
        heads(X) ~> {i in 0..len(X) | X[:i]}

rule slice_from_bottom:
    vars:
        X: seq[T1]
        i: int
    rewrite:
        X[i:] ~> 0..i <<| X

rule slice_from_top:
    vars:
        X: seq[T1]
        i: int
    rewrite:
        X[:i] ~> i..len(X) <<| X

rule set_membership:
    vars:
        X: seq[T1]
        e: T1
    rewrite:
        e in X ~> exists x in S | e = x

rule length:
    vars:
        X: seq[T1]
    rewrite:
        len(X) ~> sum x in X | 1








