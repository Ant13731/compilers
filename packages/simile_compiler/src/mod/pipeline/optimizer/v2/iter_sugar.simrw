# Count
## Vars
S: set[T1]
## Rewrite
count x . x in X ~> sum x . x in X | 1

# Cardinality
## Vars
S: set[T1]
## Rewrite
card(S) ~> count x . x in X

# Domain
## Vars
R: relation[T1, T2]
## Rewrite
dom(R) ~> {x |-> y . x |-> y in R | x}

# Range
## Vars
R: relation[T1, T2]
## Rewrite
ran(R) ~> {x |-> y . x |-> y in R | y}

# Domain Restriction
## Vars
R: relation[T1, T2]
S: set[T1]
## Rewrite
S <| R ~> {x |-> y . x |-> y in R and x in S | x |-> y}

# Domain Subtraction
## Vars
R: relation[T1, T2]
S: set[T1]
## Rewrite
S <<| R ~> {x |-> y . x |-> y in R and x not in S | x |-> y}

# Range Restriction
## Vars
R: relation[T1, T2]
S: set[T2]
## Rewrite
S |> R ~> {x |-> y . x |-> y in R and y in S | x |-> y}

# Range Subtraction
## Vars
R: relation[T1, T2]
S: set[T2]
## Rewrite
S |>> R ~> {x |-> y . x |-> y in R and y not in S | x |-> y}

# Min
## Vars
S: set[T1]
## Rewrite
min(S) ~> min x . x in S | x

# Min Map
## Vars
S: set[T1]
f: procedure[T1, T2]
## Rewrite
min_map(f, S) ~> min x . x in S | f(x)

# Max
## Vars
S: set[T1]
## Rewrite
max(S) ~> max x . x in S | x

# Max Map
## Vars
S: set[T1]
f: procedure[T1, T2]
## Rewrite
max_map(f, S) ~> max x . x in S | f(x)

# Sum
## Vars
S: set[T1]
## Rewrite
sum(S) ~> sum x . x in S | x

# Product
## Vars
S: set[T1]
## Rewrite
product(S) ~> product x . x in S | x

# Map
## Vars
S: set[T1]
f: procedure[T1, T2]
## Rewrite
map(f, S) ~> {x . x in S | f(x)}

# Fold
## Vars
S: set[T1]
f: procedure[T1, T1, T2]
i: T1
## Rewrite
fold(f, i, S) ~> fold x . x in S : i | f
