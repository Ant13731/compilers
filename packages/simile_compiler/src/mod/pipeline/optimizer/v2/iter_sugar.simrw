rule count:
    vars:
        S: set[T1]
    rewrite:
        count x . x in X ~> sum x . x in X | 1

rule cardinality:
    vars:
        S: set[T1]
    rewrite:
        card(S) ~> count x . x in X

rule domain:
    vars:
        R: relation[T1, T2]
    rewrite:
        dom(R) ~> {x |-> y . x |-> y in R | x}

rule range:
    vars:
        R: relation[T1, T2]
    rewrite:
        ran(R) ~> {x |-> y . x |-> y in R | y}

rule domain_restriction:
    vars:
        R: relation[T1, T2]
        S: set[T1]
    rewrite:
        S <| R ~> {x |-> y . x |-> y in R and x in S | x |-> y}

rule domain_subtraction:
    vars:
        R: relation[T1, T2]
        S: set[T1]
    rewrite:
        S <<| R ~> {x |-> y . x |-> y in R and x not in S | x |-> y}

rule range_restriction:
    vars:
        R: relation[T1, T2]
        S: set[T2]
    rewrite:
        S |> R ~> {x |-> y . x |-> y in R and y in S | x |-> y}

rule range_subtraction:
    vars:
        R: relation[T1, T2]
        S: set[T2]
    rewrite:
        S |>> R ~> {x |-> y . x |-> y in R and y not in S | x |-> y}

rule min:
    vars:
        S: set[T1]
    rewrite:
        min(S) ~> min x . x in S | x

rule min_map:
    vars:
        S: set[T1]
        f: procedure[T1, T2]
    rewrite:
        min_map(f, S) ~> min x . x in S | f(x)

rule max:
    vars:
        S: set[T1]
    rewrite:
        max(S) ~> max x . x in S | x

rule max_map:
    vars:
        S: set[T1]
        f: procedure[T1, T2]
    rewrite:
        max_map(f, S) ~> max x . x in S | f(x)

rule sum:
    vars:
        S: set[T1]
    rewrite:
        sum(S) ~> sum x . x in S | x

rule product:
    vars:
        S: set[T1]
    rewrite:
        product(S) ~> product x . x in S | x

rule map:
    vars:
        S: set[T1]
        f: procedure[T1, T2]
    rewrite:
        map(f, S) ~> {x . x in S | f(x)}

rule fold:
    vars:
        S: set[T1]
        f: procedure[T1, T1, T2]
        i: T1
    rewrite:
        fold(f, i, S) ~> fold x . x in S : i | f
