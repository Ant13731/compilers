rule constant_sum_upto:
    vars:
        c: int | float
        S: set[T2]
        j: int
        k: int
    rewrite:
        sum i . i in j..k | c
        ~>
        (k-j) * c
    when:
        does_not_occur_in(x,c)

rule constant_sum:
    vars:
        c: int | float
        S: set[T2]
    rewrite:
        sum x . x in S | c
        ~>
        card(S) * c
    when:
        does_not_occur_in(x,c)

rule sum_upto_i:
    vars:
        j: int
        k: int
    rewrite:
        sum i . i in j..k | i
        ~>
        -(j-k-1)*(j+k) / 2

rule sum_upto_i_squared:
    vars:
        j: int
        k: int
    rewrite:
        sum i . i in j..k | i ^ 2
        ~>
        -(j-k-1)*(2*j^2+2*j*k-j+2*k^2+k) / 6

rule sum_with_mult:
    vars:
        S: set[T1]
        m: int | float
        E: T2
    rewrite:
        sum x . x in S | E * m
        ~>
        (sum x . x in S | E) * m
