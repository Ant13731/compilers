rule count:
    vars:
        f: relation[T1, T2]
        x: T1
        E: T2
    rewrite:
        f(x) := E ~> f := f <+> {x |-> E}

rule count:
    vars:
        R: relation[T1, T2]
        Q: relation[T1, T2]
    rewrite:
        R <+> Q ~> Q \/ (dom(Q) <<| R)

rule cast:
    vars:
        X: T1
        T: type[T2]
    rewrite:
        cast(X, T) ~> X

rule cast_with:
    vars:
        X: T1
        T: type[T2]
        Ts: set[trait]
    rewrite:
        cast_with(X, T, Ts) ~> X[with Ts]

rule choice:
    vars:
        S: set[T1]
    rewrite:
        choice(S) ~> ?

rule print:
    vars:
        x: T1
    rewrite:
        print(x) ~> ?

rule functional_image:
    vars:
        R: relation[T1, T2]
        x: T1
    rewrite:
